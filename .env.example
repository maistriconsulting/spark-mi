# Copy to .env on the Fedora backend host. Never commit real credentials.
APP_NAME=SPARK-MI
APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
FRONTEND_URL=https://sparkmi.maistriconsulting.com
CORS_ORIGINS=https://sparkmi.maistriconsulting.com

# Hostinger MariaDB: enable remote access for the Fedora server IP first.
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace-with-a-strong-password
DB_SSL=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# One-time first-user/tenant setup token. Remove after initialization.
BOOTSTRAP_TOKEN=replace-with-a-separate-random-token

LOG_LEVEL=INFO
